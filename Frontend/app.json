{
  "expo": {
    "name": "Smart Docs",
    "slug": "family-vault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./public/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4a3aff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "runtimeVersion": "1.0.0",
    "android": {
      "package": "com.pdd.familyvault",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/favicon.png",
        "backgroundColor": "#4a3aff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Smart Docs to access photos.",
          "savePhotosPermission": "Allow Smart Docs to save photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smart Docs to access photos.",
          "cameraPermission": "Allow Smart Docs to access camera."
        }
      ]
    ],
    "web": {
      "favicon": "./public/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "088656f4-b2c4-4326-924e-3480bae6b68c"
      }
    },
    "owner": "aanyareddy"
  }
}
